ARG PYTHON_IMAGE=docker.io/library/python:3.13.9-slim-bookworm@sha256:b685a4fa58bb19d1814d78a1ec0f0208f351452724f78b20212c984d6e124a34
FROM ${PYTHON_IMAGE}
ENV PYTHONDONTWRITEBYTECODE=1 PYTEST_DISABLE_PLUGIN_AUTOLOAD=1 PIP_DISABLE_PIP_VERSION_CHECK=1
WORKDIR /checks
COPY requirements-build.txt requirements-dev.txt requirements-lint.txt /checks/
RUN python -m pip install --no-cache-dir -r requirements-build.txt -r requirements-dev.txt -r requirements-lint.txt
WORKDIR /src
CMD ["sh", "/input/scripts/validate-release.sh"]

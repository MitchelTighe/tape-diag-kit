{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.org/tapediag/schema/tapediag-report.v1.json",
  "title": "tapediag v1 diagnostic report",
  "type": "object",
  "properties": {
    "schema_version": {
      "const": "1.0"
    },
    "tool_version": {
      "type": "string"
    },
    "mode": {
      "enum": [
        "offline",
        "execute"
      ]
    },
    "inventory": {
      "anyOf": [
        {
          "$ref": "#/$defs/inventory"
        },
        {
          "type": "null"
        }
      ]
    },
    "drives": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "device": {
            "type": "string"
          },
          "tapealert": {
            "anyOf": [
              {
                "$ref": "#/$defs/tapealert"
              },
              {
                "type": "null"
              }
            ]
          },
          "logpages": {
            "anyOf": [
              {
                "$ref": "#/$defs/logpages"
              },
              {
                "type": "null"
              }
            ]
          },
          "drive_status": {
            "anyOf": [
              {
                "$ref": "#/$defs/drive_status"
              },
              {
                "type": "null"
              }
            ]
          }
        },
        "required": [
          "device",
          "tapealert",
          "logpages",
          "drive_status"
        ],
        "additionalProperties": false
      }
    },
    "libraries": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "device": {
            "type": "string"
          },
          "status": {
            "anyOf": [
              {
                "$ref": "#/$defs/library"
              },
              {
                "type": "null"
              }
            ]
          }
        },
        "required": [
          "device",
          "status"
        ],
        "additionalProperties": false
      }
    },
    "ltfs": {
      "anyOf": [
        {
          "$ref": "#/$defs/ltfs"
        },
        {
          "type": "null"
        }
      ]
    },
    "itdt": {
      "anyOf": [
        {
          "$ref": "#/$defs/itdt"
        },
        {
          "type": "null"
        }
      ]
    },
    "commands": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/command"
      }
    },
    "errors": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/error"
      }
    }
  },
  "required": [
    "schema_version",
    "tool_version",
    "mode",
    "inventory",
    "drives",
    "libraries",
    "ltfs",
    "itdt",
    "commands",
    "errors"
  ],
  "additionalProperties": false,
  "$defs": {
    "warnings": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "inventory_device": {
      "type": "object",
      "properties": {
        "kind": {
          "enum": [
            "drive",
            "changer"
          ]
        },
        "address": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "vendor": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "model": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "revision": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "device": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "generic_device": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "nonrewinding_device": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "kind",
        "address",
        "vendor",
        "model",
        "revision",
        "device",
        "generic_device",
        "nonrewinding_device"
      ],
      "additionalProperties": false
    },
    "inventory": {
      "type": "object",
      "properties": {
        "source": {
          "enum": [
            "lsscsi",
            "sysfs"
          ]
        },
        "devices": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/inventory_device"
          }
        },
        "warnings": {
          "$ref": "#/$defs/warnings"
        }
      },
      "required": [
        "source",
        "devices",
        "warnings"
      ],
      "additionalProperties": false
    },
    "flag": {
      "type": "object",
      "properties": {
        "flag": {
          "type": "integer",
          "minimum": 1,
          "maximum": 64
        },
        "name": {
          "type": "string"
        },
        "severity": {
          "enum": [
            "Critical",
            "Warning",
            "Info"
          ]
        },
        "action": {
          "type": "string"
        },
        "defined": {
          "type": "boolean"
        },
        "active": {
          "const": true
        }
      },
      "required": [
        "flag",
        "name",
        "severity",
        "action",
        "defined",
        "active"
      ],
      "additionalProperties": false
    },
    "tapealert": {
      "type": "object",
      "properties": {
        "page": {
          "const": "0x2e"
        },
        "profile": {
          "type": "string"
        },
        "sources": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "active_flags": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/flag"
          }
        },
        "observed_flags": {
          "type": "array",
          "items": {
            "type": "integer",
            "minimum": 1,
            "maximum": 64
          },
          "uniqueItems": true
        },
        "inactive_flags": {
          "type": "array",
          "items": {
            "type": "integer",
            "minimum": 1,
            "maximum": 64
          },
          "uniqueItems": true
        },
        "unobserved_flags": {
          "type": "array",
          "items": {
            "type": "integer",
            "minimum": 1,
            "maximum": 64
          },
          "uniqueItems": true
        },
        "unknown_flags": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "flag": {
                "type": "integer"
              },
              "value": {
                "type": "integer"
              }
            },
            "required": [
              "flag",
              "value"
            ],
            "additionalProperties": false
          }
        },
        "warnings": {
          "$ref": "#/$defs/warnings"
        }
      },
      "required": [
        "page",
        "profile",
        "sources",
        "active_flags",
        "observed_flags",
        "inactive_flags",
        "unobserved_flags",
        "unknown_flags",
        "warnings"
      ],
      "additionalProperties": false
    },
    "parameter": {
      "type": "object",
      "properties": {
        "name": {
          "type": "string"
        },
        "value": {
          "type": [
            "string",
            "number",
            "null"
          ]
        },
        "unit": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "raw": {
          "type": "string"
        }
      },
      "required": [
        "name",
        "value",
        "unit",
        "raw"
      ],
      "additionalProperties": false
    },
    "supported_page": {
      "type": "object",
      "properties": {
        "page": {
          "type": "string"
        },
        "subpage": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "name": {
          "type": "string"
        }
      },
      "required": [
        "page",
        "subpage",
        "name"
      ],
      "additionalProperties": false
    },
    "logpage": {
      "type": "object",
      "properties": {
        "page": {
          "type": "string"
        },
        "subpage": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "name": {
          "type": "string"
        },
        "known": {
          "type": "boolean"
        },
        "parameters": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/parameter"
          }
        },
        "supported_pages": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/supported_page"
          }
        },
        "raw_lines": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "required": [
        "page",
        "subpage",
        "name",
        "known",
        "parameters",
        "supported_pages",
        "raw_lines"
      ],
      "additionalProperties": false
    },
    "logpages": {
      "type": "object",
      "properties": {
        "pages": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/logpage"
          }
        },
        "preamble": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "warnings": {
          "$ref": "#/$defs/warnings"
        }
      },
      "required": [
        "pages",
        "preamble",
        "warnings"
      ],
      "additionalProperties": false
    },
    "drive_status": {
      "type": "object",
      "properties": {
        "vendor": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "product": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "revision": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "density": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ]
        },
        "density_description": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "block_size": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ]
        },
        "file_number": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ]
        },
        "block_number": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ]
        },
        "online": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ]
        },
        "write_protect": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ]
        },
        "ready": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ]
        },
        "status_flags": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "warnings": {
          "$ref": "#/$defs/warnings"
        }
      },
      "required": [
        "vendor",
        "product",
        "revision",
        "density",
        "density_description",
        "block_size",
        "file_number",
        "block_number",
        "online",
        "write_protect",
        "ready",
        "status_flags",
        "warnings"
      ],
      "additionalProperties": false
    },
    "element": {
      "type": "object",
      "properties": {
        "element": {
          "type": "integer"
        },
        "full": {
          "type": "boolean"
        },
        "barcode": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "alternate_barcode": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "source_slot": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "element",
        "full",
        "barcode",
        "alternate_barcode",
        "source_slot"
      ],
      "additionalProperties": false
    },
    "library": {
      "type": "object",
      "properties": {
        "device": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "reported_drives": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }

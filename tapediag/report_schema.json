          "type": "array",
          "items": {
            "$ref": "#/$defs/itdt_device"
          }
        },
        "inquiry": {
          "type": "object",
          "properties": {
            "vendor": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ]
            },
            "product": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ]
            },
            "revision": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ]
            }
          },
          "required": [
            "vendor",
            "product",
            "revision"
          ],
          "additionalProperties": false
        },
        "tapealert": {
          "anyOf": [
            {
              "$ref": "#/$defs/tapealert"
            },
            {
              "type": "null"
            }
          ]
        },
        "warnings": {
          "$ref": "#/$defs/warnings"
        },
        "raw_lines": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "required": [
        "adapter",
        "devices",
        "inquiry",
        "tapealert",
        "warnings",
        "raw_lines"
      ],

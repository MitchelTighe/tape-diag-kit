    "itdt_device": {
      "type": "object",
      "properties": {
        "index": {
          "type": "integer"
        },
        "device": {
          "type": "string"
        },
        "model": {
          "type": "string"
        },
        "revision": {
          "type": "string"
        },
        "serial": {
          "type": "string"
        },
        "address": {

          ]
        },
        "reported_ie_ports": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ]
        },
        "drives": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/element"
          }
        },
        "slots": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/element"
          }
        },
        "ie_ports": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/element"
          }
        },
        "warnings": {
          "$ref": "#/$defs/warnings"
        }
      },
      "required": [
        "device",
        "reported_drives",
        "reported_slots",
        "reported_ie_ports",
        "drives",
        "slots",
        "ie_ports",
        "warnings"
      ],
      "additionalProperties": false
    },
    "ltfs_device": {
      "type": "object",
      "properties": {
        "device": {
          "type": "string"
        },
        "vendor": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "product": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "serial": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "product_name": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "device",
        "vendor",
        "product",
